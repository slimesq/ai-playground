{
  "name": "0voice-av-study-tracker",
  "version": "1.0.0",
  "description": "0voice audio-video study tracker with local cache and server sync.",
  "main": "server.js",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check tracker-ui.js",
    "test:ui": "node --test tests/tracker-ui.test.js tests/resume-ui.test.js tests/navigation-ui.test.js tests/progress-navigation-ui.test.js tests/outline-optimization-ui.test.js",
    "test": "node --test tests/*.test.js",
    "test:schedule": "node --test tests/schedule-data.test.js",
    "test:sync": "node --test tests/sync-reliability.test.js tests/progress-sync.test.js"
  },
  "keywords": [
    "study-tracker",
    "express",
    "sync"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
